<script>
(function(){
  const CFG={apiKey:"AIzaSyC0Mmh2vN77NxKaxTFOW531fc-ZXBrZK6Y",authDomain:"karbarnew.firebaseapp.com",projectId:"karbarnew",storageBucket:"karbarnew.firebasestorage.app",messagingSenderId:"605322873139",appId:"1:605322873139:web:53c5b12e173aea95729646"};
  let db;
  try{
    firebase.initializeApp(CFG,'trialPublicApp');
    db=firebase.firestore(firebase.app('trialPublicApp'));
    try{ firebase.auth(firebase.app('trialPublicApp')).signInAnonymously().catch(function(){}); }catch(e2){}
  }
  catch(e){ try{ db=firebase.firestore(); }catch(err){ console.error(err); } }

  const $=id=>document.getElementById(id);
  const state={license:null, ip:null, fp:null, geo:{}};
  let timerInt=null;

  function chars(){ return 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; }
  function block(){ return Array.from({length:4},()=>chars()[Math.floor(Math.random()*32)]).join(''); }
  function genKey(){ return 'SK-TRIA-'+block()+'-'+block()+'-'+block(); }
  function rand4(){ return Math.random().toString(36).slice(2,6); }

  function fpHash(){
    try{
      let canvasSig = '';
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 200; canvas.height = 40;
        const ctx = canvas.getContext('2d');
        ctx.textBaseline = 'top'; ctx.font = '14px Arial';
        ctx.fillStyle = '#f60'; ctx.fillRect(100, 1, 50, 15);
        ctx.fillStyle = '#069'; ctx.fillText('SohozKarbar🛡️Device', 2, 10);
        canvasSig = canvas.toDataURL().slice(-50);
      } catch(e) {}

      let webglSig = '';
      try {
        const canvas = document.createElement('canvas');
        const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
        if (gl) {
          const dbg = gl.getExtension('WEBGL_debug_renderer_info');
          webglSig = dbg ? (gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) + '~' + gl.getParameter(dbg.UNMASKED_VENDOR_WEBGL)) : '';
        }
      } catch(e) {}

      const raw = [
        navigator.userAgent || '', navigator.platform || '', navigator.language || '',
        (screen.width + 'x' + screen.height + 'x' + (screen.colorDepth || 24)),
        (navigator.hardwareConcurrency || 4), (navigator.maxTouchPoints || 0),
        (Intl.DateTimeFormat().resolvedOptions().timeZone || ''), webglSig, canvasSig
      ].join('###');

      let h = 5381;
      for (let i = 0; i < raw.length; i++) { h = ((h << 5) + h) ^ raw.charCodeAt(i); }
      return 'dv_' + (h >>> 0).toString(36);
    } catch(e) { return 'dv_' + rand4() + rand4(); }
  }

  async function getIP(){
    try{ const r=await Promise.race([fetch('https://api.ipify.org?format=json').then(x=>x.json()), new Promise((_,rej)=>setTimeout(rej,4000))]); return r.ip||''; }
    catch(e){ return ''; }
  }
  async function getGeo(ip){
    if(!ip) return {};
    try{ const r=await Promise.race([fetch('https://ipapi.co/'+ip+'/json/').then(x=>x.json()), new Promise((_,rej)=>setTimeout(rej,4000))]);
      return {city:r.city||'',country:r.country_name||r.country||''}; }catch(e){ return {}; }
  }

    // Reliable Email Notification to rifat4440@gmail.com
  async function sendEmailNotification(leadData) {
    try {
      const cleanPhone = String(leadData.phone || '').replace(/[^0-9]/g, '');
      const waLink = 'https://wa.me/880' + cleanPhone.slice(-10);

      const payload = {
        name: leadData.name || 'Trial Customer',
        phone: leadData.phone || '',
        business: leadData.business || '',
        email: leadData.email || '',
        license_key: leadData.key || '',
        location: (leadData.city ? leadData.city + ', ' : '') + (leadData.country || 'Bangladesh'),
        ip_address: leadData.ip || '',
        device_details: navigator.userAgent || '',
        whatsapp_contact: waLink,
        _subject: '🎉 New trial lead: ' + (leadData.business || 'Shop') + ' — ' + (leadData.name || '') + ' (' + (leadData.phone || '') + ')',
        _template: 'table',
        _captcha: 'false',
        _replyto: leadData.email || 'rifat4440@gmail.com'
      };

      // FormSubmit.co API directly sending to rifat4440@gmail.com
      fetch('https://formsubmit.co/ajax/rifat4440@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      }).then(function(r){ return r.json(); }).then(function(data){
        console.log('[Email] FormSubmit response:', data);
      }).catch(function(err){
        console.warn('[Email] FormSubmit error:', err);
      });

    } catch (e) {
      console.warn('[Email] sendEmailNotification exception:', e);
    }
  }

  async function checkExistingDeviceTrial(fp) {
    try {
      const devDoc = await db.collection('license_customers').doc('_trial_devices').collection('devices').doc(String(fp)).get();
      if (devDoc.exists) {
        const data = devDoc.data();
        if (data.firstKey) {
          const lSnap = await db.collection('licenses').where('key', '==', data.firstKey).limit(1).get();
          if (!lSnap.empty) {
            return { id: lSnap.docs[0].id, ...lSnap.docs[0].data() };
          }
        }
      }
    } catch(e) {}
    return null;
  }

  function paint(lic){
    $('formCard').classList.add('hidden');
    $('loading').classList.add('hidden');
    $('result').classList.remove('hidden');
    $('keyText').textContent=lic.key;
    $('bizChip').innerHTML='<i class="fas fa-building text-warning"></i> '+(lic.businessName || 'Free Trial');
    $('ipChip').innerHTML='<i class="fas fa-location-dot"></i> '+(lic.ipCity ? lic.ipCity + ', ' : '') + (lic.ipCountry || 'Bangladesh');

    const chip=$('statusChip');
    function setTimer(){
      const left=(lic.expiresAt||0)-Date.now();
      if(left<=0){
        chip.className='chip bad'; chip.textContent='EXPIRED';
      $('timerText').innerHTML='<span style="color:#ef4444;">⏰ The 3-day free trial on this device has ended. Please contact us to buy the full license.</span>';
        $('copyKeyBtn').disabled=true;
        clearInterval(timerInt);
        return;
      }
      const d=Math.floor(left/86400000),h=Math.floor(left%86400000/3600000),m=Math.floor(left%3600000/60000),s=Math.floor(left%60000/1000);
      chip.className='chip ok'; chip.textContent='ACTIVE';
      $('timerText').textContent='⏳ Time left: '+d+'d '+h+'h '+m+'m '+s+'s';
    }
    setTimer(); timerInt=setInterval(setTimer,1000);
  }

  // Initial check on load
  async function init() {
    state.fp = fpHash();
    /* UPDATE 212: referral code from ?ref= or stored from landing */
    try {
      var _rq = new URLSearchParams(location.search);
      var _rc = (_rq.get('ref')||'').trim().toLowerCase();
      if (_rc && /^[a-z0-9_-]{2,20}$/.test(_rc)) localStorage.setItem('nx_ref', _rc);
      state.ref = (localStorage.getItem('nx_ref')||'').trim();
    } catch(e) { state.ref = ''; }
    state.ip = await getIP();
    state.geo = await getGeo(state.ip);

    // If this device already claimed a trial, show existing status immediately
    const existing = await checkExistingDeviceTrial(state.fp);
    if (existing) {
      state.license = existing;
      paint(existing);
    }
  }

  // Handle Form Submission
  $('trialRegForm').onsubmit = async (e) => {
    e.preventDefault();
    const name = $('t_name').value.trim();
    let phone = $('t_phone').value.trim().replace(/[^0-9]/g, '');
    const biz = $('t_biz').value.trim();
    const email = $('t_email').value.trim();
    const btype = ($('t_btype') ? $('t_btype').value : 'generic');
    const msg = $('formMsg');
    const btn = $('t_submit_btn');

    if (!name || !phone || !biz || !email) {
      msg.innerHTML = '<span style="color:#ef4444;">⚠️ Please fill in all the information.</span>';
      return;
    }
    if (phone.length < 10) {
      msg.innerHTML = '<span style="color:#ef4444;">⚠️ Please enter a valid 11-digit mobile number.</span>';
      return;
    }
    if (phone.startsWith('880')) phone = '0' + phone.slice(3);
    if (!phone.startsWith('01')) phone = '0' + phone;

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating key...';
    msg.innerHTML = '';

    try {
      const existing = await checkExistingDeviceTrial(state.fp);
      if (existing) {
        paint(existing);
        return;
      }

      const id = 'lic_' + Date.now() + '_' + rand4();
      const key = genKey();
      const tenantId = 'trial-' + phone.slice(-6) + '-' + rand4();

      const lic = {
        id, key, tenantId,
        customerName: name,
        businessName: biz,
        businessType: btype,
        mobile: phone,
        email: email,
        licenseType: 'trial',
        trialDays: 3,
        plan: 'Trial 3 Days',
        months: 0,
        maxDevices: 1,
        devices: [],
        status: 'active',
        createdAt: Date.now(),
        expiresAt: Date.now() + 3 * 86400000,
        createdBy: 'trial-registration-page',
        ref: String(state.ref || ''),
        trialIp: String(state.ip || ''),
        ipCity: String(state.geo.city || ''),
        ipCountry: String(state.geo.country || ''),
        trialFp: String(state.fp || ''),
        claimedAt: Date.now(),
        source: 'trial-form'
      };

      // Save into licenses
      await db.collection('licenses').doc(id).set(lic);

      // Register device in _trial_devices
      try {
        await db.collection('license_customers').doc('_trial_devices').collection('devices').doc(String(state.fp)).set({
          deviceHash: String(state.fp),
          firstKey: key,
          licenseId: id,
          customerName: name,
          businessName: biz,
          createdAt: Date.now(),
          expiresAt: lic.expiresAt,
          ip: String(state.ip || '')
        }, { merge: true });
      } catch(e) {}

      // Mirror to license_customers
      try {
        const cref = db.collection('license_customers').doc(tenantId);
        await cref.set({
          tenantId, customerName: name, businessName: biz, businessType: btype,
          currentLicenseKey: key,
          licenseStatus: 'active', expiresAt: lic.expiresAt, updatedAt: Date.now()
        }, { merge: true });
        await cref.collection('licenses').doc(id).set({ id: id, tenantId: tenantId }, { merge: true });
      } catch(e) {}

      // Mirror to trial_leads
      try {
        await db.collection('trial_leads').doc(key).set({
          key, name, phone, business: biz, email,
          ip: state.ip, city: state.geo.city || '', country: state.geo.country || '',
          createdAt: Date.now(), expiresAt: lic.expiresAt,
          ref: String(state.ref || '')
        });
      } catch(e) {}

      // Send Email Notification to rifat4440@gmail.com
      sendEmailNotification({
        name, phone, business: biz, email, key,
        ip: state.ip, city: state.geo.city, country: state.geo.country
      });

      // Save local lock
      try {
        localStorage.setItem('sohoz_trial_fp', state.fp);
        localStorage.setItem('sohoz_trial_key', key);
        localStorage.setItem('sohoz_trial_exp', String(lic.expiresAt));
      } catch(e) {}

      state.license = lic;
      paint(lic);

    } catch(err) {
      console.error(err);
      msg.innerHTML = '<span style="color:#ef4444;">Server problem: ' + err.message + '</span>';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-key"></i> 🚀 Create My Free 3-Day Trial Key';
    }
  };

  $('copyKeyBtn').onclick = async () => {
    try {
      await navigator.clipboard.writeText(state.license.key);
    $('copyKeyBtn').innerHTML = '<i class="fas fa-check"></i> Key copied!';
      setTimeout(() => { $('copyKeyBtn').innerHTML = '<i class="fas fa-copy"></i> Copy Trial Key'; }, 1800);
    } catch(e) {
      prompt('Copy key:', state.license.key);
    }
  };

  $('copyCredBtn').onclick = async () => {
    try {
      await navigator.clipboard.writeText('User: Admin | Password: 123456');
    $('copyCredBtn').innerHTML = '<i class="fas fa-check"></i> ID & password copied!';
      setTimeout(() => { $('copyCredBtn').innerHTML = '<i class="fas fa-copy"></i> Copy ID & Password'; }, 1800);
    } catch(e) {
      prompt('Credentials:', 'User: Admin | Password: 123456');
    }
  };

  init();
})();
</script>
